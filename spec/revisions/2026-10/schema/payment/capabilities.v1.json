{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-10:payment/capabilities.v1.json",
  "title": "payment.capabilities.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "payment.capabilities.v1"
    },
    "driver": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "driverVersion": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "provider": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "providerApiVersion": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "paymentMethodFamily": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "initiate": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "authorize": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "idempotency": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "keyed",
            "unverified"
          ]
        },
        "keyScope": {
          "enum": [
            "none",
            "account",
            "account_action",
            "operation"
          ]
        },
        "guaranteedTtlSeconds": {
          "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
        }
      },
      "required": [
        "mode",
        "keyScope",
        "guaranteedTtlSeconds"
      ],
      "additionalProperties": false
    },
    "lookup": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "partial",
                "complete",
                "unverified"
              ]
            },
            "retentionSeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            },
            "visibilityDelaySeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            }
          },
          "required": [
            "mode",
            "retentionSeconds",
            "visibilityDelaySeconds"
          ],
          "additionalProperties": false
        },
        "business_ref": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "partial",
                "complete",
                "unverified"
              ]
            },
            "retentionSeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            },
            "visibilityDelaySeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            }
          },
          "required": [
            "mode",
            "retentionSeconds",
            "visibilityDelaySeconds"
          ],
          "additionalProperties": false
        },
        "refund_ref": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "partial",
                "complete",
                "unverified"
              ]
            },
            "retentionSeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            },
            "visibilityDelaySeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            }
          },
          "required": [
            "mode",
            "retentionSeconds",
            "visibilityDelaySeconds"
          ],
          "additionalProperties": false
        },
        "event_id": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "partial",
                "complete",
                "unverified"
              ]
            },
            "retentionSeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            },
            "visibilityDelaySeconds": {
              "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/counter"
            }
          },
          "required": [
            "mode",
            "retentionSeconds",
            "visibilityDelaySeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider_id",
        "business_ref",
        "refund_ref",
        "event_id"
      ],
      "additionalProperties": false
    },
    "capture": {
      "enum": [
        "none",
        "full",
        "partial_single",
        "partial_multiple",
        "unverified"
      ]
    },
    "refund": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "partialRefund": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "multipleRefund": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "callback": {
      "type": "object",
      "properties": {
        "authenticity": {
          "enum": [
            "none",
            "signed",
            "unverified"
          ]
        },
        "identity": {
          "enum": [
            "none",
            "stable_event_id",
            "unverified"
          ]
        }
      },
      "required": [
        "authenticity",
        "identity"
      ],
      "additionalProperties": false
    },
    "asynchronousStates": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "inventory": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "settlement": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "disputes": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "savedMethod": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "recurringConsent": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "fiscalPassthrough": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "digest": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/digest"
    },
    "voidMode": {
      "enum": [
        "none",
        "full",
        "partial",
        "unverified"
      ]
    }
  },
  "required": [
    "schema",
    "driver",
    "driverVersion",
    "provider",
    "providerApiVersion",
    "paymentMethodFamily",
    "initiate",
    "authorize",
    "idempotency",
    "lookup",
    "capture",
    "voidMode",
    "refund",
    "partialRefund",
    "multipleRefund",
    "callback",
    "asynchronousStates",
    "inventory",
    "settlement",
    "disputes",
    "savedMethod",
    "recurringConsent",
    "fiscalPassthrough",
    "digest"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "idempotency": {
            "properties": {
              "mode": {
                "const": "keyed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "idempotency": {
            "properties": {
              "keyScope": {
                "enum": [
                  "account",
                  "account_action",
                  "operation"
                ]
              },
              "guaranteedTtlSeconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ]
}
