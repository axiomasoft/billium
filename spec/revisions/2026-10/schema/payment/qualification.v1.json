{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-10:payment/qualification.v1.json",
  "title": "payment.qualification.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "payment.qualification.v1"
    },
    "driver": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "driverVersion": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "provider": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "providerApiVersion": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
    },
    "capabilityDigest": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/digest"
    },
    "checkedAt": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/timestamp"
    },
    "qualification": {
      "enum": [
        "simulated",
        "sandbox",
        "production"
      ]
    },
    "status": {
      "enum": [
        "qualified",
        "unqualified"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://.+"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "checkedAt": {
            "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/timestamp"
          }
        },
        "required": [
          "url",
          "version",
          "checkedAt"
        ],
        "additionalProperties": false
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
      }
    },
    "rotation": {
      "type": "object",
      "properties": {
        "identityContinuity": {
          "enum": [
            "supported",
            "unsupported",
            "unverified"
          ]
        },
        "historicalLookup": {
          "enum": [
            "supported",
            "unsupported",
            "unverified"
          ]
        },
        "historicalRefund": {
          "enum": [
            "supported",
            "unsupported",
            "unverified"
          ]
        },
        "historicalCapture": {
          "enum": [
            "supported",
            "unsupported",
            "unverified"
          ]
        },
        "evidenceRef": {
          "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/ref"
        }
      },
      "required": [
        "identityContinuity",
        "historicalLookup",
        "historicalRefund",
        "historicalCapture",
        "evidenceRef"
      ],
      "additionalProperties": false
    },
    "unresolvedGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "digest": {
      "$ref": "urn:billium:spec:2026-10:common/defs.json#/$defs/digest"
    }
  },
  "required": [
    "schema",
    "driver",
    "driverVersion",
    "provider",
    "providerApiVersion",
    "capabilityDigest",
    "checkedAt",
    "qualification",
    "status",
    "sources",
    "evidenceRefs",
    "rotation",
    "unresolvedGaps",
    "digest"
  ],
  "additionalProperties": false
}
