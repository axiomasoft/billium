{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-12:event/event.v1.json",
  "title": "Событие outbox",
  "type": "object",
  "required": [
    "schema",
    "eventId",
    "eventType",
    "sellerRef",
    "aggregateRef",
