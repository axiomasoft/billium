{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-12:event/event.v2.json",
  "title": "Negotiated public event (D63)",
  "type": "object",
  "required": [
    "schema",
    "eventId",
    "eventType",
    "sellerRef",
    "aggregateRef",
    "revision",
    "occurredAt",
    "digest",
    "payload",
    "eventContractRevision"
  ],
  "properties": {
    "schema": {
      "const": "billium.event.v2"
    },
    "eventId": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ulid"
    },
    "eventType": {
      "enum": [
        "payment.effect.outcome.v1"
      ]
    },
    "sellerRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "aggregateRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "revision": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/counter"
    },
    "occurredAt": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
    },
    "payload": {
      "$ref": "urn:billium:spec:2026-12:payment/effect-outcome.v1.json"
    },
    "eventContractRevision": {
      "const": "events-2026-10-v2"
    }
  }
}
