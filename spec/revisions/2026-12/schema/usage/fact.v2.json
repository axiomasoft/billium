{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-12:usage/fact.v2.json",
  "title": "usage.fact.v2 (D56; owner usage)",
  "type": "object",
  "required": [
    "schema",
    "sellerRef",
    "source",
    "factId",
    "revision",
    "metricRef",
    "metricVersion",
    "metricDigest",
    "unit",
    "attribution",
    "interval",
    "eventAt",
    "receivedAt",
    "value",
    "grouping",
    "billableStream",
    "provenance",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "usage.fact.v2"
    },
    "sellerRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "source": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "factId": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "revision": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/counter"
    },
    "metricRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "metricVersion": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "metricDigest": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
    },
    "unit": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/unit"
    },
    "attribution": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/attribution"
    },
    "interval": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/interval"
    },
    "eventAt": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/timestamp"
    },
    "receivedAt": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/timestamp"
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "quantity"
          ],
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "quantity": {
              "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/quantity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "quantity"
          ],
          "properties": {
            "kind": {
              "const": "count"
            },
            "quantity": {
              "const": "1"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "members"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object"
    },
    "grouping": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/dimension"
      }
    },
    "billableStream": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/stream"
    },
    "provenance": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/provenance"
    },
    "correction": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/correction"
    },
    "digest": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
    }
  },
  "additionalProperties": false
}
