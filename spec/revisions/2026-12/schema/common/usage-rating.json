{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-12:common/usage-rating.json",
  "title": "P4 immutable usage and pricing definitions (D13/D56; owners usage/rating)",
  "$defs": {
    "quantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,23})(\\.[0-9]{1,9})?$"
    },
    "rate": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,23})(\\.[0-9]{1,12})?$"
    },
    "minor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "unit": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/p4Unit"
    },
    "interval": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/interval"
    },
    "attribution": {
      "type": "object",
      "required": [
        "customerRef",
        "billingAccountRef",
        "subjectRef",
        "componentRef",
        "agreementRef",
        "agreementRevision",
        "attributionVersion",
        "effectiveAt"
      ],
      "properties": {
        "customerRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "billingAccountRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "subjectRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "componentRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "agreementRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "agreementRevision": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/counter"
        },
        "attributionVersion": {
          "const": "host_snapshot/1"
        },
        "effectiveAt": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "stream": {
      "type": "object",
      "required": [
        "mode",
        "policy",
        "commercialBasisRef",
        "normalizationRef"
      ],
      "properties": {
        "mode": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/p4StreamMode"
        },
        "policy": {
          "const": "exclusive_commercial_basis/1"
        },
        "commercialBasisRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "normalizationRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "collector",
        "version",
        "sourceRef",
        "sourceDigest"
      ],
      "properties": {
        "collector": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "version": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "sourceRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "sourceDigest": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "required": [
        "correctionRef",
        "supersedesRevision",
        "originalFactDigest"
      ],
      "properties": {
        "correctionRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "supersedesRevision": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/counter"
        },
        "originalFactDigest": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "value": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        }
      },
      "additionalProperties": false
    },
    "frontier": {
      "type": "object",
      "required": [
        "source",
        "partition",
        "throughSequence",
        "effectiveRevisionDigest"
      ],
      "properties": {
        "source": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "partition": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "throughSequence": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/counter"
        },
        "effectiveRevisionDigest": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "const": "additive_sum"
            },
            "version": {
              "const": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "const": "additive_count"
            },
            "version": {
              "const": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "revisionPolicy",
            "sampleReducer",
            "tieBreak"
          ],
          "properties": {
            "id": {
              "const": "gauge"
            },
            "version": {
              "const": 1
            },
            "revisionPolicy": {
              "const": "highest_fact_revision"
            },
            "sampleReducer": {
              "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/p4GaugeReducer"
            },
            "tieBreak": {
              "const": "eventAt_source_factId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "reducer"
          ],
          "properties": {
            "id": {
              "const": "exact_distinct"
            },
            "version": {
              "const": 1
            },
            "reducer": {
              "const": "set_union"
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object"
    },
    "extraction": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "field"
          ],
          "properties": {
            "kind": {
              "const": "decimal_field"
            },
            "field": {
              "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "each_fact"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "field"
          ],
          "properties": {
            "kind": {
              "const": "member_field"
            },
            "field": {
              "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object"
    },
    "rounding": {
      "type": "object",
      "required": [
        "policy",
        "mode",
        "boundaries"
      ],
      "properties": {
        "policy": {
          "const": "named_boundaries/1"
        },
        "mode": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/roundingMode"
        },
        "boundaries": {
          "const": "subtotal_then_bounds_then_tax"
        }
      },
      "additionalProperties": false
    },
    "tax": {
      "type": "object",
      "required": [
        "snapshotRef",
        "snapshotDigest",
        "policyVersion",
        "correctionPolicyVersion",
        "mode",
        "rate"
      ],
      "properties": {
        "snapshotRef": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "snapshotDigest": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
        },
        "policyVersion": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "correctionPolicyVersion": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
        },
        "mode": {
          "const": "exclusive"
        },
        "rate": {
          "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
        }
      },
      "additionalProperties": false
    },
    "commitment": {
      "type": "object",
      "required": [
        "policy",
        "scope",
        "minimumMinor",
        "maximumMinor"
      ],
      "properties": {
        "policy": {
          "const": "same_component_period/1"
        },
        "scope": {
          "const": "seller_customer_component_period"
        },
        "minimumMinor": {
          "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/minor"
        },
        "maximumMinor": {
          "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/minor"
        }
      },
      "additionalProperties": false
    },
    "quantityConversion": {
      "type": "object",
      "required": [
        "numerator",
        "denominator",
        "quantityScale"
      ],
      "properties": {
        "numerator": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/positiveIntString"
        },
        "denominator": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/positiveIntString"
        },
        "quantityScale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      },
      "additionalProperties": false
    },
    "strategy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "amount"
          ],
          "properties": {
            "id": {
              "const": "fixed"
            },
            "version": {
              "const": 1
            },
            "amount": {
              "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "unitPrice"
          ],
          "properties": {
            "id": {
              "const": "per_unit"
            },
            "version": {
              "const": 1
            },
            "unitPrice": {
              "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "unitPrice",
            "quantityConversion"
          ],
          "properties": {
            "id": {
              "const": "per_unit"
            },
            "version": {
              "const": 2
            },
            "unitPrice": {
              "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
            },
            "quantityConversion": {
              "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/quantityConversion"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "tiers",
            "overflowUnitPrice"
          ],
          "properties": {
            "id": {
              "const": "graduated"
            },
            "version": {
              "const": 1
            },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "upTo",
                  "unitPrice"
                ],
                "properties": {
                  "upTo": {
                    "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/quantity"
                  },
                  "unitPrice": {
                    "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
                  }
                },
                "additionalProperties": false
              }
            },
            "overflowUnitPrice": {
              "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "tiers",
            "overflowUnitPrice"
          ],
          "properties": {
            "id": {
              "const": "volume"
            },
            "version": {
              "const": 1
            },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "upTo",
                  "unitPrice"
                ],
                "properties": {
                  "upTo": {
                    "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/quantity"
                  },
                  "unitPrice": {
                    "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
                  }
                },
                "additionalProperties": false
              }
            },
            "overflowUnitPrice": {
              "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/rate"
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object"
    },
    "completeness": {
      "type": "object",
      "required": [
        "watermark",
        "status",
        "policy"
      ],
      "properties": {
        "watermark": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/timestamp"
        },
        "status": {
          "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/p4Completeness"
        },
        "policy": {
          "const": "source_frontier/1"
        }
      },
      "additionalProperties": false
    },
    "localTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    }
  }
}
