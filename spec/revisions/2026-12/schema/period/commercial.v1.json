{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-12:period/commercial.v1.json",
  "title": "period.commercial.v1 (D56; owner period)",
  "type": "object",
  "required": [
    "schema",
    "periodRef",
    "sellerRef",
    "componentRef",
    "agreementRef",
    "agreementRevision",
    "interval",
    "localStart",
    "localEnd",
    "timezone",
    "tzdbVersion",
    "calendarPolicy",
    "frequency",
    "anchor",
    "shortMonthPolicy",
    "dstGapPolicy",
    "dstFoldPolicy",
    "prorationPolicy",
    "chargeTiming",
    "externalCorrelationRef",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "period.commercial.v1"
    },
    "periodRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "sellerRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "componentRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "agreementRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "agreementRevision": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/counter"
    },
    "interval": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/interval"
    },
    "localStart": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/localTimestamp"
    },
    "localEnd": {
      "$ref": "urn:billium:spec:2026-12:common/usage-rating.json#/$defs/localTimestamp"
    },
    "timezone": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "tzdbVersion": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "calendarPolicy": {
      "const": "anchored_calendar/1"
    },
    "frequency": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/p4Frequency"
    },
    "anchor": {
      "type": "object",
      "required": [
        "day",
        "month",
        "localTime",
        "endOfMonth"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "localTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "endOfMonth": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "shortMonthPolicy": {
      "const": "clamp_preserve_anchor"
    },
    "dstGapPolicy": {
      "const": "shift_forward"
    },
    "dstFoldPolicy": {
      "const": "earlier_offset"
    },
    "prorationPolicy": {
      "const": "whole_interval/1"
    },
    "chargeTiming": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/p4ChargeTiming"
    },
    "externalCorrelationRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "digest": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest"
    }
  },
  "additionalProperties": false
}
