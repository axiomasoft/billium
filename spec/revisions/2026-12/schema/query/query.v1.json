{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-12:query/query.v1.json",
  "title": "Запрос чтения",
  "type": "object",
  "required": [
    "schema",
    "installationRef",
    "environment",
    "sellerRef",
    "query",
    "selector"
  ],
  "properties": {
    "schema": {
      "const": "billium.query.v1"
    },
    "installationRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "environment": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "sellerRef": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "query": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/queryKind"
    },
    "asOf": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/timestamp"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "cursor": {
      "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
    },
    "selector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref"
      }
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {"query": {"const": "dueObligations"}}
  },
  "then": {
    "required": ["asOf", "limit"],
    "properties": {
      "selector": {"required": ["billingAccountRef"]}
    }
  },
  "else": {
    "not": {
      "anyOf": [
        {"required": ["asOf"]},
        {"required": ["limit"]},
        {"required": ["cursor"]}
      ]
    }
  }
}
