{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:billium:spec:2026-12:capabilities/capabilities.v2.json",
  "title": "Negotiated capabilities of a Billium installation (2026-12)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "installationRef",
    "environment",
    "specRevision",
    "specHash",
    "supportedSpecRevisions",
    "supportedUnits",
    "usageIngressSchemas",
    "ratingStrategyVersions",
    "serverApiVersion",
    "acceptedCommandSchemas",
    "producedResponseSchemas",
    "eventSchemas",
    "enabledModules",
    "moduleApiVersions",
    "features",
    "effects",
    "limits",
    "lookupCompletenessPolicyRef",
    "catalogs",
    "selectionMode",
    "digest"
  ],
  "properties": {
    "schema": { "const": "billium.capabilities.v2" },
    "installationRef": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref" },
    "environment": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref" },
    "specRevision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "specHash": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest" },
    "supportedSpecRevisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "specHash"],
        "properties": {
          "revision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "specHash": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest" }
        }
      }
    },
    "supportedUnits": {
      "type": "array",
      "items": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/p4Unit" }
    },
    "usageIngressSchemas": {
      "type": "array",
      "items": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/envelopeName" }
    },
    "ratingStrategyVersions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z_]+@[1-9][0-9]*$" }
    },
    "serverApiVersion": { "const": "1" },
    "acceptedCommandSchemas": {
      "type": "array",
      "items": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/envelopeName" }
    },
    "producedResponseSchemas": {
      "type": "array",
      "items": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/envelopeName" }
    },
    "eventSchemas": {
      "type": "array",
      "items": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/envelopeName" }
    },
    "enabledModules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "apiVersion"],
        "properties": {
          "module": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref" },
          "apiVersion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "moduleApiVersions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["charge", "refund", "find", "receipt", "document", "execution"],
      "properties": {
        "charge": { "type": "boolean" },
        "refund": { "type": "boolean" },
        "find": { "type": "boolean" },
        "receipt": { "type": "boolean" },
        "document": { "type": "boolean" },
        "execution": { "type": "boolean" }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sale", "authorize", "capture", "voidAuthorization", "cancel"],
      "properties": {
        "sale": { "type": "boolean" },
        "authorize": { "type": "boolean" },
        "capture": { "type": "boolean" },
        "voidAuthorization": { "type": "boolean" },
        "cancel": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBodyBytes", "maxDepth"],
      "properties": {
        "maxBodyBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "lookupCompletenessPolicyRef": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/ref" },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventContractRevision", "envelopeSchema", "eventTypes"],
        "properties": {
          "eventContractRevision": { "type": "string", "minLength": 1 },
          "envelopeSchema": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/envelopeName" },
          "eventTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "selectionMode": { "const": "explicit" },
    "digest": { "$ref": "urn:billium:spec:2026-12:common/defs.json#/$defs/digest" }
  }
}
