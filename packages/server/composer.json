{
    "name": "axiomasoft/billium-server",
    "description": "Laravel HTTP delivery for the Billium core.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "axiomasoft/billium-contracts": "^0.1",
        "axiomasoft/billium-core": "^0.1",
        "axiomasoft/billium-ledger": "^0.1",
        "axiomasoft/packman": "^0.1.1",
        "laravel/framework": "^13.0"
    },
    "suggest": {
        "axiomasoft/billium-execution": "Execution is bundled with core and enabled only for the remote-billium composition."
    },
    "autoload": {
        "psr-4": {
            "Billium\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Billium\\Server\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Billium\\Server\\BilliumServerServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "domain",
            "stability": "dev",
            "owns": ["Contracts", "Data", "Enums", "Exceptions", "Internal"]
        }
    },
    "prefer-stable": true
}
