{
    "name": "axiomasoft/billium-core",
    "description": "Billium core: Laravel 13 platform and ledger modules.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-pdo_pgsql": "*",
        "axiomasoft/billium-contracts": "^0.1",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Billium\\Core\\": "src/",
            "Billium\\Platform\\": "modules/platform/src/",
            "Billium\\Ledger\\": "modules/ledger/src/",
            "Billium\\Usage\\": "modules/usage/src/",
            "Billium\\Rating\\": "modules/rating/src/",
            "Billium\\Schedule\\": "modules/schedule/src/",
            "Billium\\Execution\\": "modules/execution/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Billium\\Core\\BilliumCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
