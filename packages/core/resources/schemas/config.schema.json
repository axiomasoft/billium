{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "axiomasoft/billium-core configuration",
    "type": "object",
    "properties": {
        "billium": {
            "type": "object",
            "properties": {
                "collection": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                },
                "connection": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null
                },
                "documents": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                },
                "execution": {
                    "type": "object",
                    "properties": {
                        "outgoing_enabled": {
                            "type": "boolean",
                            "default": false
                        },
                        "release_evidence_ref": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "retention_policy_ref": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        }
                    },
                    "additionalProperties": false
                },
                "feed": {
                    "type": "object",
                    "properties": {
                        "bootstrap_batch": {
                            "type": "integer",
                            "default": 100
                        },
                        "bootstrap_lease_seconds": {
                            "type": "integer",
                            "default": 60
                        },
                        "drain_batch": {
                            "type": "integer",
                            "default": 100
                        },
                        "signing_key": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        }
                    },
                    "additionalProperties": false
                },
                "financial_session": {
                    "type": "object",
                    "properties": {
                        "seal_lock_timeout_ms": {
                            "type": "integer",
                            "default": 5000
                        }
                    },
                    "additionalProperties": false
                },
                "idempotency": {
                    "type": "object",
                    "properties": {
                        "lock_timeout_ms": {
                            "type": "integer",
                            "default": 5000
                        }
                    },
                    "additionalProperties": false
                },
                "inbox": {
                    "type": "object",
                    "properties": {
                        "handler_compatibility": {
                            "type": [
                                "array",
                                "object"
                            ]
                        },
                        "retention_floor_seconds": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "retry_backoff_seconds": {
                            "type": "integer",
                            "default": 5
                        },
                        "retry_budget": {
                            "type": "integer",
                            "default": 10
                        }
                    },
                    "additionalProperties": false
                },
                "installation_ref": {
                    "type": [
                        "string",
                        "integer",
                        "number",
                        "boolean",
                        "null"
                    ],
                    "default": null
                },
                "ledger": {
                    "type": "object",
                    "properties": {
                        "refund_reconcile_after_seconds": {
                            "type": "integer",
                            "default": 3600
                        }
                    },
                    "additionalProperties": false
                },
                "modules": {
                    "type": "object",
                    "properties": {
                        "composition": {
                            "type": "string",
                            "default": "embedded-commerz"
                        },
                        "enabled": {
                            "type": "array"
                        }
                    },
                    "additionalProperties": false
                },
                "outbox": {
                    "type": "object",
                    "properties": {
                        "claim_seconds": {
                            "type": "integer",
                            "default": 60
                        },
                        "delivery_backoff_seconds": {
                            "type": "integer",
                            "default": 5
                        },
                        "delivery_budget": {
                            "type": "integer",
                            "default": 10
                        },
                        "maintenance_connection": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "relay_batch": {
                            "type": "integer",
                            "default": 100
                        },
                        "retention_floor_seconds": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        }
                    },
                    "additionalProperties": false
                },
                "rating": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                },
                "runner": {
                    "type": "object",
                    "properties": {
                        "max_attempts": {
                            "type": "integer",
                            "default": 3
                        },
                        "root_deadline_ms": {
                            "type": "integer",
                            "default": 30000
                        }
                    },
                    "additionalProperties": false
                },
                "runtime_role": {
                    "type": "object",
                    "properties": {
                        "preflight": {
                            "type": "boolean",
                            "default": true
                        }
                    },
                    "additionalProperties": false
                },
                "schedule": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                },
                "usage": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
