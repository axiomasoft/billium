{
  "zones": [
    {
      "id": "spec",
      "paths": ["spec/**", "scripts/spec/**"],
      "layers": ["lint", "derived", "conformance"]
    },
    {
      "id": "fixtures",
      "paths": ["fixtures/**"],
      "layers": ["lint", "derived", "conformance"]
    },
    {
      "id": "conformance",
      "paths": ["conformance/**"],
      "layers": ["conformance"]
    },
    {
      "id": "php-contracts",
      "paths": ["packages/contracts/**", "conformance/adapters/php/**"],
      "layers": ["php", "conformance"]
    },
    {
      "id": "php-core",
      "paths": ["packages/core/**", "packages/core/modules/**", "packages/core/database/**", "packages/core/config/**", "scripts/db/**", "scripts/lint/test-discovery.py", "scripts/lint/tests/**", "composer.json", "composer.lock", "packman.json", "phpstan.neon", "pint.json", "rector.php", "phpunit.xml", "tests/**"],
      "layers": ["php", "conformance"]
    },
    {
      "id": "dart-contracts",
      "paths": ["packages/contracts-dart/**", "conformance/adapters/dart/**"],
      "layers": ["dart", "conformance"]
    },
    {
      "id": "toolchain",
      "paths": ["docker/**", "compose.yaml", "scripts/ci.sh", ".github/**"],
      "layers": ["lint", "derived", "php", "dart", "conformance"]
    }
  ]
}
