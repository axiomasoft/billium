        "billingAccountRef": "account-a",
        "obligationRef": "o1",
        "basisRef": "basis-o1",
        "customerRef": "customer-a",
        "componentRef": "component-o1",
        "amount": {
          "amount": "100.00",
          "currency": "RUB"
        },
        "termsDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "taxSnapshotRef": "tax-o1"
      }
    },
    {
      "op": "ledger.query",
      "args": {
        "query": "obligation",
        "selector": {
          "obligationRef": "o1"
        }
      }
    },
    {
      "op": "ledger.query",
      "args": {
        "query": "dueObligations",
        "selector": {
          "billingAccountRef": "account-a"
        },
        "asOf": "2026-10-30T00:00:00Z",
        "limit": 10
      }
    }
  ],
  "expect": [
    {
      "ok": {}
    },
    {
      "ok": {}
    },
    {
      "ok": {
        "dueAt": null,
        "open": {
          "amount": "100.00",
          "currency": "RUB"
        }
      }
    },
    {
      "ok": {
        "obligations": []
      }
    }
  ]
}
