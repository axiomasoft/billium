{
  "id": "ledger/conservation/null-due-not-automatic",
  "description": "D60/BC-ENV-28: null dueAt stays open and is absent from due collection candidates.",
  "spec_refs": [
    "BC-CNF-10",
    "REQ-ACC-10",
    "D60",
    "BC-ENV-28"
  ],
  "profiles": [
    "php"
  ],
  "given": {
    "caller": {
      "sellerRef": "seller-a",
      "environment": "test",
      "installationRef": "inst-test",
      "sourceAuthorities": [
        "embedded-commerz"
      ]
    }
  },
  "script": [
    {
      "op": "ledger.reset",
      "args": {}
    },
    {
      "op": "ledger.obligation.record",
      "args": {
