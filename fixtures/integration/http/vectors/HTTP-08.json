{
  "protocol": "billium.http.transcript.v1",
  "id": "HTTP-08",
  "title": "Source gap custody is durable and replay preserves cumulative ledger totals",
  "profile": "ledger",
  "sources": [
    "D55",
    "D63",
    "INV-08"
  ],
  "steps": [
    {
      "op": "snapshot",
      "name": "before",
      "expect": {
        "counts.outbox_event": 2
      }
    },
    {
      "op": "send",
      "name": "gap",
      "path": "/billium/v1/sellers/seller-a/observations",
      "scoped": true,
      "body": {
        "schema": "payment.observation.v1",
        "eventId": "01JBX5Q0Z8M3N4P7R9S2000002",
        "sourceAuthority": "embedded-commerz",
        "sourceLineage": "L1",
        "partitionRef": "gap",
        "sourceSequence": 2,
        "operationRef": "root-a",
        "operationKind": "charge",
        "businessIntentRef": "intent-a",
        "operationRevision": 2,
        "state": "succeeded",
        "currency": "RUB",
        "requested": {
          "amount": "100.00",
          "currency": "RUB"
        },
        "authorizedTotal": {
          "amount": "100.00",
          "currency": "RUB"
        },
        "capturedTotal": {
          "amount": "70.00",
          "currency": "RUB"
        },
        "refundedTotal": {
          "amount": "0.00",
          "currency": "RUB"
        },
        "providerAccountRef": "fixture-pa",
        "evidenceRef": "fixture-evidence-2",
        "observedAt": "2026-11-19T00:00:00Z",
        "recordedAt": "2026-11-19T00:00:01Z"
      },
      "expect": {
        "status": 202,
        "body.schema": "ledger.observation_custody.v1",
        "body.custodyStatus": "parked_gap",
        "body.receipt": "none"
      },
      "seal": "contentDigest"
    },
    {
      "op": "snapshot",
      "name": "parked",
      "expect": {
        "counts.inbox_message": 1,
        "counts.allocation_receipt": {"$ref": "before.counts.allocation_receipt"},
        "inbox.0.status": "parked_gap"
      }
    },
    {
      "op": "send",
      "name": "gapAgain",
      "use": "gap",
      "expect": {
        "status": 202,
        "body.schema": "ledger.observation_custody.v1",
        "body.custodyStatus": "parked_gap",
        "body.receipt": "none"
      }
    },
    {
      "op": "snapshot",
      "name": "noGapDup",
      "expect": {
        "counts": {
          "$ref": "parked.counts"
        },
        "events": {
          "$ref": "parked.events"
        },
        "receipts": {
          "$ref": "parked.receipts"
        },
        "operations": {
          "$ref": "parked.operations"
        },
        "attempts": {
          "$ref": "parked.attempts"
        },
        "inbox": {
          "$ref": "parked.inbox"
        }
      }
    },
    {
      "op": "send",
      "name": "predecessor",
      "path": "/billium/v1/sellers/seller-a/observations",
      "scoped": true,
      "body": {
        "schema": "payment.observation.v1",
        "eventId": "01JBX5Q0Z8M3N4P7R9S2000001",
        "sourceAuthority": "embedded-commerz",
        "sourceLineage": "L1",
        "partitionRef": "gap",
        "sourceSequence": 1,
        "operationRef": "root-a",
        "operationKind": "charge",
        "businessIntentRef": "intent-a",
        "operationRevision": 1,
        "state": "succeeded",
        "currency": "RUB",
        "requested": {
          "amount": "100.00",
          "currency": "RUB"
        },
        "authorizedTotal": {
          "amount": "100.00",
          "currency": "RUB"
        },
        "capturedTotal": {
          "amount": "30.00",
          "currency": "RUB"
        },
        "refundedTotal": {
          "amount": "0.00",
          "currency": "RUB"
        },
        "providerAccountRef": "fixture-pa",
        "evidenceRef": "fixture-evidence-1",
        "observedAt": "2026-11-19T00:00:00Z",
        "recordedAt": "2026-11-19T00:00:01Z"
      },
      "expect": {
        "status": 200,
        "body.schema": "ledger.allocation_receipt.v1",
        "body.replayed": false
      },
      "seal": "contentDigest"
    },
    {
      "op": "send",
      "name": "retry",
      "use": "gap",
      "expect": {
        "status": 200,
        "body.schema": "ledger.allocation_receipt.v1"
      }
    },
    {
      "op": "send",
      "name": "payment",
      "path": "/billium/v1/sellers/seller-a/queries",
      "scoped": true,
      "body": {
        "schema": "billium.query.v1",
        "query": "paymentStatus",
        "selector": {
          "paymentRef": "root-a"
        }
      },
      "expect": {
        "status": 200,
        "body.schema": "ledger.payment_status.v1",
        "body.result.applied.capturedTotal.amount": "70.00",
        "body.result.observed.capturedTotal.amount": "70.00"
      }
    },
    {
      "op": "snapshot",
      "name": "final",
      "expect": {
        "counts.inbox_message": 2,
        "counts.inbox_conflict": 0
      }
    }
  ]
}
