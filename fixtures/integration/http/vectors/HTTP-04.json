        "grant": {
          "grantRef": "fixture-grant-a",
          "sellerRef": "seller-a",
          "operationRef": "root-a"
        },
        "admission": {
          "$ref": "replayed.body"
        },
        "outcome": {
          "$ref": "ledger.body"
        },
        "allocation": {
          "$ref": "allocation.body"
        },
        "loseResponse": true
