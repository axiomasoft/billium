{
  "protocol": "billium.http.transcript.v1",
  "id": "HTTP-04",
  "title": "Close TCP after committed admission, replay exact prepared bytes and recover one outcome",
  "profile": "execution",
  "sources": [
    "D57",
    "D58",
    "D59",
    "COV-AC-524"
