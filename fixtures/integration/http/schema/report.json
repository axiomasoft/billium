                      "const": "pass"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "HTTP-10"
                    },
                    "status": {
                      "const": "pass"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "id": {
