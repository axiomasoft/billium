{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8.5 HTTP transcript report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "client",
    "suite",
    "required",
    "runtime",
    "results",
    "evidence",
    "hashes",
    "passed",
    "requiredSuitePassed"
  ],
  "properties": {
    "protocol": {
      "const": "billium.http.transcript.v1"
    },
    "client": {
      "enum": [
        "php",
        "dart"
      ]
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "const": [
        "HTTP-01",
        "HTTP-02",
        "HTTP-03",
        "HTTP-04",
        "HTTP-05",
        "HTTP-06",
        "HTTP-07",
        "HTTP-08",
        "HTTP-09",
        "HTTP-10",
        "HTTP-11",
        "HTTP-12",
        "HTTP-13",
        "HTTP-14",
        "HTTP-15",
        "HTTP-16",
        "HTTP-17",
        "HTTP-18",
        "HTTP-19",
        "HTTP-20",
        "HTTP-21"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "php": {
          "type": "string",
          "pattern": "^8\\.4\\."
        },
        "postgres": {
          "type": "string",
          "pattern": "^PostgreSQL (1[6-9]|[2-9][0-9])\\."
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "sources",
          "profile",
          "transcript"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HTTP-(0[1-9]|1[0-9]|2[01])$"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(D[0-9]+|BC-[A-Z]+-[0-9]+|INV-[0-9]+|COV-AC-[0-9]+)$"
            }
          },
          "profile": {
            "enum": [
              "execution",
              "ledger",
              "custody"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "transcript": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_class",
                "boundary",
                "step",
                "action",
                "observed"
              ],
              "properties": {
                "evidence_class": {
                  "enum": [
                    "server-runtime",
                    "transport-contract",
                    "provider-double",
                    "host-double"
                  ]
                },
                "boundary": {
                  "enum": [
                    "loopback",
                    "double"
                  ]
                },
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "enum": [
                    "send",
                    "snapshot",
                    "worker",
                    "late_evidence",
                    "provider",
                    "drain",
                    "disable_writer",
                    "stop_new",
                    "deliver",
                    "checkpoint",
                    "restore",
                    "correlate",
                    "codec",
                    "archive",
                    "wait",
                    "compare",
                  "seed_seller",
                  "activate_custody"
                  ]
                },
                "observed": {}
              },
              "oneOf": [
                {
                  "properties": {
                    "evidence_class": {
                      "const": "server-runtime"
                    },
                    "boundary": {
                      "const": "loopback"
                    }
                  }
                },
                {
                  "properties": {
                    "evidence_class": {
                      "const": "transport-contract"
                    },
                    "boundary": {
                      "const": "loopback"
                    }
                  }
                },
                {
                  "properties": {
                    "evidence_class": {
                      "const": "provider-double"
                    },
                    "boundary": {
                      "const": "double"
                    }
                  }
                },
                {
                  "properties": {
                    "evidence_class": {
                      "const": "host-double"
                    },
                    "boundary": {
                      "const": "double"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_class",
          "boundary",
          "steps"
        ],
        "properties": {
          "evidence_class": {
            "enum": [
              "server-runtime",
              "transport-contract",
              "provider-double",
              "host-double"
            ]
          },
          "boundary": {
            "enum": [
              "loopback",
              "double"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "oneOf": [
          {
            "properties": {
              "evidence_class": {
                "const": "server-runtime"
              },
              "boundary": {
                "const": "loopback"
              }
            }
          },
          {
            "properties": {
              "evidence_class": {
                "const": "transport-contract"
              },
              "boundary": {
                "const": "loopback"
              }
            }
          },
          {
            "properties": {
              "evidence_class": {
                "const": "provider-double"
              },
              "boundary": {
                "const": "double"
              }
            }
          },
          {
            "properties": {
              "evidence_class": {
                "const": "host-double"
              },
              "boundary": {
                "const": "double"
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "evidence_class": {
                "const": "server-runtime"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "evidence_class": {
                "const": "transport-contract"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "evidence_class": {
                "const": "provider-double"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "evidence_class": {
                "const": "host-double"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "fixtures",
        "harness",
        "packages",
        "dependencies"
      ],
      "properties": {
        "spec": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fixtures": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "harness": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packages": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "passed": {
      "type": "boolean"
    },
    "requiredSuitePassed": {
      "type": "boolean"
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requiredSuitePassed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "passed": {
            "const": true
          },
          "suite": {
            "enum": [
              "all",
              "required"
            ]
          },
          "results": {
            "minItems": 21,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "HTTP-01"
                    },
                    "status": {
                      "const": "pass"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "HTTP-02"
                    },
