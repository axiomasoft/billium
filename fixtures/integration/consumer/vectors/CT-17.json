{
  "protocol": "billium.consumer.bridge.case.v1",
  "id": "CT-17",
  "title": "Host provisioning outage after settled payment triggers provision-only retry with zero extra charges",
  "standProfile": "execution",
  "authoritySource": "remote-billium",
  "executionProfile": "remote-billium",
  "packageDelivery": "php-contracts-current",
  "sources": ["D58", "D61", "COV-AC-524"],
  "steps": [
    {
      "name": "admitCharge",
      "target": "consumer",
      "op": "http_command",
      "args": {
        "path": "/billium/v1/sellers/seller-a/payments/execute",
        "body": {
          "schema": "payment.execute.v1",
          "installationRef": "inst-test",
          "environment": "test",
          "sellerRef": "seller-a",
          "commandKey": "00000000-0000-4100-8800-000000001701",
          "operationRef": "ct17-op-1",
          "operationKind": "charge",
          "source": { "context": "checkout", "intentRef": "intent-a", "orderRef": "ct17-order" },
          "executionProfile": "remote-billium",
          "routingEpoch": 1,
          "merchantAccountRef": "account-a",
          "money": { "amount": "10.00", "currency": "RUB" },
          "bindingRevision": "merchant-a",
          "requestedAt": "2026-11-22T10:00:00Z"
        }
      },
      "expect": { "status": 202 }
    },
    {
      "name": "dispatchCharge",
      "target": "stand",
      "op": "worker_dispatch",
      "args": { "operation": "ct17-op-1" },
      "expect": { "reductions.0": "applied" }
    },
    {
      "name": "relayToLedger",
      "target": "stand",
      "op": "relay_observations",
      "expect": { "exitCode": 0, "deliveredTotal": 1 }
    },
    {
      "name": "provisioningOutageAndRetry",
      "target": "consumer",
      "op": "host_provisioning_drill",
      "args": { "paymentRef": "ct17-op-1", "grantKey": "ct17-grant-1" },
      "expect": {
        "firstSucceeded": false,
        "firstRetryProvisionOnly": true,
        "firstChargeTriggered": false,
        "secondSucceeded": true,
        "secondChargeTriggered": false,
        "idempotentReceiptRef": true,
        "extraChargesTriggered": 0,
        "activeGrant": true
      }
    },
    {
      "name": "singleProviderCharge",
      "target": "stand",
      "op": "provider_evidence",
      "expect": { "calls.#": 1 }
    },
    {
      "name": "singleOperationRow",
      "target": "stand",
      "op": "snapshot",
      "expect": { "counts.execution_operation": 1 }
    }
  ]
}
