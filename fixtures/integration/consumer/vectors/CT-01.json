{
  "protocol": "billium.consumer.bridge.case.v1",
  "id": "CT-01",
  "title": "Execute duplicate and lost accepted response recover with exact prepared bytes and single PSP call",
  "standProfile": "execution",
  "authoritySource": "remote-billium",
  "executionProfile": "remote-billium",
  "packageDelivery": "php-contracts-current",
  "sources": ["D58", "D59", "INV-04", "INV-05"],
  "steps": [
    {
      "name": "lostResponse",
      "target": "consumer",
      "op": "http_command",
      "args": {
        "saveAs": "execCmd",
        "path": "/billium/v1/sellers/seller-a/payments/execute",
        "fault": "drop_response",
        "body": {
          "schema": "payment.execute.v1",
          "installationRef": "inst-test",
          "environment": "test",
          "sellerRef": "seller-a",
          "commandKey": "00000000-0000-4100-8800-000000000101",
          "operationRef": "ct01-op-1",
          "operationKind": "charge",
          "source": {
            "context": "checkout",
            "intentRef": "intent-a",
            "orderRef": "ct01-order-1"
          },
          "executionProfile": "remote-billium",
          "routingEpoch": 1,
          "merchantAccountRef": "account-a",
          "money": { "amount": "10.00", "currency": "RUB" },
          "bindingRevision": "merchant-a",
          "requestedAt": "2026-11-22T10:00:00Z"
        }
      },
      "expect": {
        "outcome": "lost_response",
        "upstreamCommitted": true,
        "sameBytes": true,
        "newKeyMinted": false,
        "cancelInvoked": false
      }
    },
    {
      "name": "committedSnapshot",
      "target": "stand",
      "op": "snapshot",
      "expect": {
        "counts.execution_operation": 1,
        "counts.execution_attempt": 1
      }
    },
    {
      "name": "replayExact",
      "target": "consumer",
      "op": "replay_prepared",
      "args": { "use": "execCmd" },
      "expect": {
        "status": 202,
        "body.result": "accepted",
        "body.receipt": "CommandAccepted",
        "body.operationRef": "ct01-op-1",
        "sameBytes": true,
        "newKeyMinted": false,
        "cancelInvoked": false
      }
    },
    {
      "name": "dispatch",
      "target": "stand",
      "op": "worker_dispatch",
      "args": { "operation": "ct01-op-1", "mode": "success" },
      "expect": {
        "reductions.0": "applied",
        "delivery.providerOutcomeRecorded": true
      }
    },
    {
      "name": "find",
      "target": "consumer",
      "op": "http_command",
      "args": {
        "path": "/billium/v1/sellers/seller-a/operations/find",
        "body": {
          "schema": "payment.find.v1",
          "installationRef": "inst-test",
          "environment": "test",
          "sellerRef": "seller-a",
          "operationRef": "ct01-op-1"
        }
      },
      "expect": {
        "status": 200,
        "body.status": "succeeded",
        "body.capturedTotal.amount": "10.00"
      }
    },
    {
      "name": "provider",
      "target": "stand",
      "op": "provider_evidence",
      "expect": {
        "calls.#": 1,
        "calls.0.operation": "ct01-op-1"
      }
    }
  ]
}
