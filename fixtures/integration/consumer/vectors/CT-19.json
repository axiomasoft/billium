{
  "protocol": "billium.consumer.bridge.case.v1",
  "id": "CT-19",
  "title": "Cancelled authorization before dispatch prevents send while late provider success retains discrepancy fact",
  "standProfile": "execution",
  "authoritySource": "remote-billium",
  "executionProfile": "remote-billium",
  "packageDelivery": "php-contracts-current",
  "sources": ["D57", "D58", "PB-22", "ACC-CON-07"],
  "steps": [
    {
      "name": "admitAuthA",
      "target": "consumer",
      "op": "http_command",
      "args": {
        "path": "/billium/v1/sellers/seller-a/payments/authorize",
        "body": {
          "schema": "payment.authorize.v1",
          "installationRef": "inst-test",
          "environment": "test",
          "sellerRef": "seller-a",
          "commandKey": "00000000-0000-4100-8800-000000001901",
          "operationRef": "ct19-auth-a",
          "operationKind": "charge",
          "source": { "context": "checkout", "intentRef": "intent-a", "orderRef": "ct19-order-a" },
          "executionProfile": "remote-billium",
          "routingEpoch": 1,
          "merchantAccountRef": "account-a",
          "money": { "amount": "1.00", "currency": "RUB" },
          "bindingRevision": "merchant-a",
          "requestedAt": "2026-11-22T10:00:00Z"
        }
      },
      "expect": { "status": 202, "body.receipt": "CommandAccepted" }
    },
    {
      "name": "cancelBeforeDispatch",
      "target": "consumer",
      "op": "http_command",
      "args": {
        "path": "/billium/v1/sellers/seller-a/operations/ct19-auth-a/cancel",
        "body": {
          "schema": "payment.cancel.v1",
          "installationRef": "inst-test",
          "environment": "test",
          "sellerRef": "seller-a",
          "commandKey": "00000000-0000-4100-8800-000000001902",
          "operationRef": "ct19-auth-a"
        }
      },
      "expect": { "status": 200, "body.result": "known-terminal" }
    },
    {
      "name": "workerSkipsCancelled",
      "target": "stand",
      "op": "worker_dispatch",
      "args": { "operation": "ct19-auth-a" },
      "expect": { "attemptStatus": "cancelled" }
    },
    {
      "name": "zeroCallsAfterCancel",
      "target": "stand",
      "op": "provider_evidence",
      "expect": { "calls.#": 0 }
    },
    {
      "name": "lateProviderSuccessRetainsFact",
      "target": "stand",
      "op": "late_provider_callback",
      "args": { "operation": "ct19-auth-a", "amountMinor": 100 },
      "expect": {
        "disposition": "held_discrepancy",
        "evidenceRetained": true,
        "discrepancyReason": "late_positive_after_no_effect"
      }
    },
    {
      "name": "admitAuthB",
      "target": "consumer",
      "op": "http_command",
      "args": {
        "path": "/billium/v1/sellers/seller-a/payments/authorize",
        "body": {
          "schema": "payment.authorize.v1",
          "installationRef": "inst-test",
          "environment": "test",
          "sellerRef": "seller-a",
          "commandKey": "00000000-0000-4100-8800-000000001903",
          "operationRef": "ct19-auth-b",
          "operationKind": "charge",
          "source": { "context": "checkout", "intentRef": "intent-ct19-b", "orderRef": "ct19-order-b" },
          "executionProfile": "remote-billium",
          "routingEpoch": 1,
          "merchantAccountRef": "account-a",
          "money": { "amount": "1.00", "currency": "RUB" },
          "bindingRevision": "merchant-a",
          "requestedAt": "2026-11-22T10:01:00Z"
        }
      },
      "expect": { "status": 202 }
    },
    {
      "name": "dispatchAuthBTimeout",
      "target": "stand",
      "op": "worker_dispatch",
      "args": { "operation": "ct19-auth-b", "mode": "accepted_then_timeout" },
      "expect": { "attemptStatus": "unknown" }
    },
    {
      "name": "cancelRefusedAfterDispatch",
      "target": "consumer",
      "op": "http_command",
      "args": {
        "path": "/billium/v1/sellers/seller-a/operations/ct19-auth-b/cancel",
        "body": {
          "schema": "payment.cancel.v1",
          "installationRef": "inst-test",
          "environment": "test",
          "sellerRef": "seller-a",
          "commandKey": "00000000-0000-4100-8800-000000001904",
          "operationRef": "ct19-auth-b"
        }
      },
      "expect": {
        "status": 409,
        "body.code": "billium.operation.not_cancellable"
      }
    }
  ]
}
