              "amount": "10.00",
              "currency": "RUB"
            },
            "ratios": [
              "1",
              "1",
              "1"
            ]
          }
        }
      ],
      "expect": [
        {
          "ok": {
            "parts": [
              {
                "amount": "3.34",
                "currency": "RUB"
              },
              {
                "amount": "3.33",
                "currency": "RUB"
              },
              {
                "amount": "3.33",
                "currency": "RUB"
              }
            ]
          }
        }
      ]
    },
